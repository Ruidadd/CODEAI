{
    "agents": {
        "primaryModel": "moonshot/kimi-k2.5",
        "imageModel": "moonshot/kimi-k2.5-vision",
        "fallbackModel": "moonshot/moonshot-v1-128k",
        "temperature": 0.7,
        "maxTokens": 4096
    },
    "modelProviders": {
        "moonshot": {
            "apiKey": "YOUR_MOONSHOT_API_KEY",
            "baseUrl": "https://api.moonshot.cn/v1",
            "enabled": true,
            "models": [
                "kimi-k2.5",
                "kimi-k2.5-vision",
                "moonshot-v1-128k",
                "moonshot-v1-32k",
                "moonshot-v1-8k"
            ]
        }
    },
    "gateway": {
        "port": 18789,
        "host": "0.0.0.0"
    },
    "security": {
        "allowedOrigins": ["http://YOUR_SERVER_IP:18789"],
        "rateLimit": {
            "enabled": true,
            "maxRequests": 60,
            "windowMs": 60000
        }
    },
    "logging": {
        "level": "info",
        "file": "/home/node/.openclaw/logs/openclaw.log"
    }
}
