name: Daily AI Intelligence Collection

on:
  # Run daily at 8 AM UTC
  schedule:
    - cron: '0 8 * * *'

  # Allow manual trigger
  workflow_dispatch:

jobs:
  collect:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          pip install -r requirements.txt

      - name: Run intelligence collector
        env:
          YOUTUBE_API_KEY: ${{ secrets.YOUTUBE_API_KEY }}
          TWITTER_BEARER_TOKEN: ${{ secrets.TWITTER_BEARER_TOKEN }}
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: |
          python collect_cli.py --days 1 --max-videos 10

      - name: Upload artifacts
        uses: actions/upload-artifact@v3
        with:
          name: ai-intelligence-report
          path: notebooklm_sources/
          retention-days: 30

      # Optional: Commit results back to repo
      # - name: Commit results
      #   run: |
      #     git config --local user.email "action@github.com"
      #     git config --local user.name "GitHub Action"
      #     git add notebooklm_sources/
      #     git commit -m "Daily intelligence report $(date +%Y-%m-%d)" || echo "No changes"
      #     git push
