# ============================================================
# Digital Employee — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Anthropic / Claude (REQUIRED) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-6

# ── Digital Employee Identity (REQUIRED) ────────────────────
# The email account this digital employee "owns"
EMPLOYEE_EMAIL=digital-alex@yourcompany.com
EMPLOYEE_NAME=Alex
EMPLOYEE_DISPLAY_NAME=Alex (Digital Assistant)

# ── Microsoft Azure AD App Registration ─────────────────────
# Required for Email and Teams integration
# Create an app at: https://portal.azure.com → Azure Active Directory → App registrations
# Required permissions (Application):
#   - Mail.Read, Mail.Send, Mail.ReadWrite
#   - ChannelMessage.Read.All, ChatMessage.Read
#   - Calendars.Read, OnlineMeetings.Read.All
#   - Presence.Read.All, User.Read.All
MS_TENANT_ID=your-tenant-id-here
MS_CLIENT_ID=your-client-id-here
MS_CLIENT_SECRET=your-client-secret-here

# ── Webhook Configuration ────────────────────────────────────
# Public URL where MS Graph can send notifications
# Use ngrok for local dev: ngrok http 8000
WEBHOOK_BASE_URL=https://your-public-url.example.com

# ── Senior Stakeholders ──────────────────────────────────────
# Who receives the morning briefing, EOD digest, and weekly reports
CEO_EMAIL=ceo@yourcompany.com
COO_EMAIL=coo@yourcompany.com
# Comma-separated additional recipients
REPORT_RECIPIENTS=vp-ops@yourcompany.com,chief-of-staff@yourcompany.com

# ── Application Settings ─────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DB_PATH=digital_employee.db
LOG_LEVEL=INFO

# ── Scheduler Intervals ──────────────────────────────────────
EMAIL_CHECK_INTERVAL_MIN=5
TEAMS_CHECK_INTERVAL_MIN=5
FOLLOWUP_INTERVAL_MIN=15
MORNING_BRIEFING_HOUR=8
EOD_DIGEST_HOUR=17

# ── Feature Flags ────────────────────────────────────────────
# Enable automatic email responses (use with caution in production)
ENABLE_AUTO_RESPOND=false
ENABLE_TEAMS_MONITORING=true
ENABLE_EMPLOYEE_HEALTH=true
