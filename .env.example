# YouTube Data API v3
# Get your key: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 in your Google Cloud project
YOUTUBE_API_KEY=your_youtube_api_key_here

# Twitter/X API v2 Bearer Token
# Get your token: https://developer.twitter.com/en/portal/dashboard
# You need Essential access (free tier)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Anthropic Claude API
# Get your key: https://console.anthropic.com/
# Used for AI-powered content understanding and ranking
ANTHROPIC_API_KEY=your_anthropic_api_key_here
