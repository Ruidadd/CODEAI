.start { padding-top: 40rpx; padding-bottom: 80rpx; }
.hero { text-align: center; padding: 10rpx 0 30rpx; }
.hero-mark { font-size: 88rpx; line-height: 1; }
.title { font-size: 84rpx; letter-spacing: 10rpx; margin-top: 10rpx; font-family: "STKaiti", "KaiTi", "Songti SC", serif; }
.tagline { color: #555b61; margin-top: 10rpx; font-size: 28rpx; }
.civ-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.civ {
  width: calc((100% - 28rpx) / 3); border: 4rpx solid #d8d2c3; background: #fffdf8; border-radius: 22rpx; padding: 18rpx 8rpx;
  display: flex; flex-direction: column; align-items: center; gap: 2rpx; text-align: center;
}
.civ .ci { font-size: 54rpx; line-height: 1.1; }
.civ .cn { font-size: 34rpx; font-family: "STKaiti", "KaiTi", serif; }
.civ .cb { font-size: 22rpx; color: #868b90; line-height: 1.3; }
.row2 { display: flex; gap: 20rpx; }
.half { flex: 1; min-width: 0; }
.start-actions { display: flex; flex-direction: column; gap: 18rpx; margin-top: 10rpx; }
.help .hl { color: #555b61; font-size: 28rpx; margin-top: 12rpx; }
.help .hb { color: #1f2429; font-weight: 600; }
.help .civs { display: flex; flex-direction: column; gap: 6rpx; margin-top: 8rpx; }
.help .civline { font-size: 26rpx; color: #555b61; }
